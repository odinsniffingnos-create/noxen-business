{
  "name": "noxen-business",
  "description": "Noxen Business dashboard app",
  "author": "Noxen",
  "private": true,
  "version": "1.0.0",
  "main": "electron-main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4173",
    "build": "vite build",
    "server": "node server.js",
    "start": "node web-server.js",
    "dev:all": "concurrently \"npm run server\" \"npm run dev\"",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "generate:icon": "node scripts/generate-icon.js",
    "electron": "electron .",
    "electron:build": "npm run generate:icon && vite build && electron-builder --config electron-builder.json",
    "dist:all": "npm run generate:icon && vite build && electron-builder --config electron-builder.json --publish never"
  },
  "dependencies": {
    "concurrently": "^9.1.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "lucide-react": "^0.525.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.0",
    "stripe": "^22.6.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "pngjs": "^7.0.0",
    "vite": "^5.4.10"
  }
}
